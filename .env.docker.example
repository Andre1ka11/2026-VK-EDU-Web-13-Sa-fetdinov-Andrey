DEBUG=False
SECRET_KEY=replace-with-a-real-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=unidb
DB_USER=postgres
DB_PASSWORD=replace-with-a-real-password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_BROKER_DB=1
REDIS_BEAT_DB=2

# Email (maildev)
EMAIL_HOST=maildev
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=uniask@localhost

# Centrifugo
CENTRIFUGO_API_URL=http://centrifugo:8000/api
CENTRIFUGO_API_KEY=replace-with-api-key
CENTRIFUGO_TOKEN_SECRET=replace-with-token-secret
CENTRIFUGO_WS_URL=ws://localhost:8001/connection/websocket
CENTRIFUGO_ADMIN_PASSWORD=replace-with-admin-password
CENTRIFUGO_ADMIN_SECRET=replace-with-admin-secret
