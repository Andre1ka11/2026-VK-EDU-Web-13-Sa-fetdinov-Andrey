echo "DEBUG=True" > .env.local
echo "SECRET_KEY=your-secret-key-here" >> .env.local
echo "DB_ENGINE=django.db.backends.postgresql" >> .env.local
echo "DB_NAME=unidb" >> .env.local
echo "DB_USER=postgres" >> .env.local
echo "DB_PASSWORD=mysecretpassword" >> .env.local
echo "DB_HOST=localhost" >> .env.local
echo "DB_PORT=5432" >> .env.local